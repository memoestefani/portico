# .env.production.example - Configuración Soberana Cloudflare para Pórtico OS
# Copiar este archivo como .env en el servidor o máquina anfitriona

# 1. Cloudflare Tunnel (Zero Trust Ingress)
# Obtenido desde Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# 2. Cloudflare R2 Object Storage (Respaldos continuos Litestream a $0 egress)
# Obtenido desde Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=tu_account_id_de_cloudflare
CLOUDFLARE_R2_BUCKET=portico-wal-backups
CLOUDFLARE_R2_ACCESS_KEY_ID=tu_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu_r2_secret_key

# 3. Clave Criptográfica del Propietario (OperatorHq)
# Clave aleatoria de 32+ caracteres para autorizar la consola administrativa
OPERATOR_KEY=portico_sovereign_operator_key_2026_xyz123
